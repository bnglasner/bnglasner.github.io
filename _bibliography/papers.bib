}

@article{ananat2024ctc_employment,
  abbr = {JPubE},
  title = {Effects of the expanded Child Tax Credit on employment outcomes},
  author = {Ananat, Elizabeth and Glasner, Benjamin and Hamilton, Christal and Parolin, Zachary and Pignatti, Clemente},
  journal = {Journal of Public Economics},
  year = {2024},
  volume = {238},
  pages = {105168},
  doi = {10.1016/j.jpubeco.2024.105168},
  abstract = {The 2021 expansion of the Child Tax Credit provided monthly cash payments to most U.S. families with children from July through December of that year. Using difference-in-differences analyses of Current Population Survey and Census Household Pulse data from April through December 2021, this paper tests whether the expansion's documented reductions in poverty and hardship came at the cost of reduced parental employment. Estimated effects on employment and labor force participation are small, inconsistently signed, and not statistically significant.},
  finding = {The expanded Child Tax Credit's monthly payments reduced poverty and hardship without reducing parental employment or labor force participation.},
  entry_group = {peer_reviewed},
  bibtex_show = {true},
  selected = {true},
  publisher = {North-Holland},
}

@techreport{ozimek_lettieri_glasner_2024_american_worker,
  abbr = {EIG},
  title = {The American Worker Project: Toward a New Consensus},
  author = {Ozimek, Adam and Lettieri, John and Glasner, Ben},
  journal = {Economic Innovation Group},
  institution = {Economic Innovation Group},
  year = {2024},
  month = {June},
