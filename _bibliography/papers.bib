@techreport{glasner_2023_noncompetes_workingpaper,
  abbr = {EIG},
  title = {The Effects of Noncompete Agreement Reforms on Business Formation: A Comparison of Hawaii and Oregon},
  author = {Glasner, Benjamin},
  institution = {Economic Innovation Group},
  year = {2023},
  month = {March},
  website = {https://eig.org/noncompetes-research-note/},
  pdf = {https://eig.org/wp-content/uploads/2023/03/Noncompete-Reform-Research-Note.pdf},
  abstract = {This research note compares two state-level noncompete reforms: Hawaii's exemption for technology-sector workers and Oregon's reform covering lower-wage workers. Hawaii's targeted tech-sector exemption is associated with a 10 percent increase in the number of technology establishments, while Oregon's broader low-wage reform shows no statistically significant effect on business formation. The contrast suggests that restricting noncompetes spurs entrepreneurship most effectively when it covers higher-skilled, knowledge-based workers.},
  finding = {Hawaii's noncompete exemption for technology workers raised the number of technology establishments by 10 percent, while Oregon's broader low-wage-worker reform showed no significant effect.},
  entry_group = {policy_report},
  bibtex_show = {true},
}

@article{glasner2023minimumwage_gig,
  abbr = {JLE},
  title = {The Minimum Wage, Self-Employment, and the Online Gig Economy},
  author = {Glasner, Benjamin},
  journal = {Journal of Labor Economics},
  year = {2023},
  volume = {41},
  number = {1},
  pages = {103--127},
  doi = {10.1086/719690},
  abstract = {This paper studies how minimum wage increases affect work arrangements that minimum wage law does not cover, including self-employment and gig work. In the early 2000s, minimum wage increases led to modest declines in traditional self-employment. After the online gig economy emerged in the 2010s, the relationship flipped: a 10 percent increase in the minimum wage increased the number of nonemployer establishments in transportation and warehousing by about 2.7 percent, an effect concentrated in counties with less concentrated labor markets and active ride-hailing platforms.},
  finding = {Minimum wage increases pushed some workers into gig and nonemployer self-employment, concentrated in transportation and warehousing after ride-hailing platforms emerged.},
  entry_group = {peer_reviewed},
  bibtex_show = {true},
  selected = {true},
  publisher = {The University of Chicago},
}

