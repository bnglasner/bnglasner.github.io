  pdf = {https://eig.org/wp-content/uploads/2025/02/The_Impact_of_Opportunity_Zones_on_Housing_Supply.pdf},
  abstract = {Using HUD administrative data on address vacancies, this study measures how Opportunity Zone designation affected new housing construction between 2019 and early 2025. Designated tracts saw new housing construction rise by 70 percent relative to comparable non-designated tracts, adding more than 416,000 net new residential addresses. About 97 of every 100 new addresses represented genuine additional supply rather than displacement from nearby areas.},
  finding = {Opportunity Zone designation increased new housing construction by 70 percent in eligible tracts, adding more than 416,000 residential addresses with little displacement from nearby areas.},
  entry_group = {policy_report},
