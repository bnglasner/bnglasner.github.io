  pdf = {https://eig.org/wp-content/uploads/2024/06/The-American-Worker-Project.pdf},
  abstract = {The American Worker Project assembles evidence on how the typical American worker is faring across pay, benefits, job quality, and mobility. It argues that workers are more prosperous than prior generations by most measures, but that the pace of improvement has slowed and that public perception of the labor market often lags what the underlying data show. The project calls for a shared, evidence-based understanding of worker well-being to ground policy debate.},
