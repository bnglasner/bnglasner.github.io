  bibtex_show = {true},
}

@techreport{fikri_glasner_2023_oz_literature,
  abbr = {EIG},
  title = {Are Opportunity Zones Working? What the Literature Tells Us},
  author = {Fikri, Kenan and Glasner, Ben},
  institution = {Economic Innovation Group},
  year = {2023},
  month = {October},
  website = {https://eig.org/are-opportunity-zones-working/},
  abstract = {This brief takes stock of the growing academic literature evaluating Opportunity Zones five years after the program's enactment. Effect estimates on early outcomes range from positive to null, but many of the most widely cited studies analyze a window that ends before Opportunity Zone regulations were even finalized, an implausibly early period for detecting real effects. Studies that observe at least two years of activity under fully finalized regulations find the strongest positive investment effects, suggesting that patience and correct timing matter for judging the policy fairly.},
  finding = {Studies that wait long enough to observe Opportunity Zones under fully finalized regulations find the strongest positive investment effects; many widely cited early studies end their analysis window too soon to detect them.},
  entry_group = {policy_report},
  bibtex_show = {true},
}

@techreport{maury_jia_yera_glasner_2023_liquid_assets,
  abbr = {RobinHood},
  title = {Liquid Assets, Financial Shocks, and Entrances into Material Hardship},
  author = {Maury, Matthew and Collyer, Sophie and Glasner, Ben and Jia, Yajun and Wimer, Christopher and Yera, Christopher},
  journal = {Poverty Tracker (Robin Hood)},
  institution = {Center on Poverty and Social Policy at Columbia University (Robin Hood Poverty Tracker Spotlight)},
  year = {2023},
  month = {August},
  website = {https://robinhood.org/reports/annual-report-the-state-of-poverty-and-disadvantage-in-new-york-city-vol-6/},
  pdf = {https://robinhood.org/wp-content/uploads/2024/01/poverty-tracker_2023.08_spotlight-on-liquid-assets-financial-shocks-and-entrances-into-material-hardship.pdf},
  abstract = {Using Poverty Tracker survey data on New York City households, this report examines whether liquid financial assets protect working-age adults from falling into material hardship after a financial shock such as a job loss, income drop, or loss of benefits. Working-age New Yorkers who experience a shock are more than twice as likely to enter hardship as those who do not, and those who lose a job or benefits are more than three times as likely. The risk of entering hardship after a shock falls sharply as liquid assets rise to $2,000, after which the protective effect levels off.},
  finding = {New Yorkers with $2,000 in liquid assets are substantially less likely to fall into material hardship after a financial shock than those with none, and the protective effect levels off above that amount.},
  entry_group = {policy_report},
  bibtex_show = {true},
}

@techreport{glasner_parolin_2023_foodstamp,
  abbr = {EquitableGrowth},
  title = {The Effectiveness of the Food Stamp Program at Reducing Racial Differences in the Intergenerational Persistence of Poverty},
  author = {Glasner, Benjamin and Mincy, Ronald B. and Parolin, Zachary and Wimer, Christopher},
  journal = {Working paper},
  institution = {Washington Center for Equitable Growth},
  year = {2023},
  month = {May},
  website = {https://equitablegrowth.org/working-papers/the-effectiveness-of-the-food-stamp-program-at-reducing-differences-in-the-intergenerational-persistence-of-poverty/},
  pdf = {https://equitablegrowth.org/wp-content/uploads/2023/05/053023-WP-The-Effectiveness-of-the-Food-Stamp-Program-at-Reducing-Racial-Differences-in-the-Intergenerational-Persistence-of-Poverty.pdf},
  abstract = {This working paper studies whether childhood access to the Food Stamp Program (SNAP's predecessor) affects poverty in adulthood, and whether its effects differ by race. Exploiting the program's staggered county-by-county rollout, the paper finds that Food Stamp Program access reduced adult poverty by five percentage points overall. The reduction is substantially larger for Black adults whose parents lacked a high school education, including a nine-point reduction in deep poverty for that group, narrowing racial gaps in intergenerational economic mobility.},
  finding = {The food stamp program reduced adult poverty by five percentage points overall, with a nine-point reduction in deep poverty for Black adults whose parents lacked a high school education.},
