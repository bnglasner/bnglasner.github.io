}

@techreport{carlson_glasner_ozimek_2023_full_vs_hybrid,
  abbr = {EIG},
  title = {Full vs. Hybrid: Examining the Consequences of How Americans Work Remotely},
  author = {Carlson, Eric and Glasner, Benjamin and Ozimek, Adam},
  institution = {Economic Innovation Group},
  year = {2023},
  month = {November},
  website = {https://eig.org/full-vs-hybrid-remote-work/},
  abstract = {This report compares the economic consequences of full-remote and hybrid remote work arrangements. Full-remote work significantly improves employment among people with disabilities, enables longer-distance moves, and raises housing prices in the communities that receive these movers. Hybrid work, by contrast, enables shorter-distance moves that keep workers within commuting range of their metro area and is associated with weaker house-price growth in destination markets.},
  finding = {Full-remote work raises long-distance migration and destination-market housing prices, while hybrid work enables shorter moves without the same price effect.},
  entry_group = {policy_report},
  bibtex_show = {true},
}

