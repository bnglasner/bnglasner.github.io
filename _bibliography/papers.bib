@techreport{ozimek_glasner_2025_wage_subsidy,
  abbr = {EIG},
  title = {How to end low-wage work forever: An 80-80 wage subsidy proposal},
  author = {Glasner, Ben and Ozimek, Adam},
  institution = {Economic Innovation Group},
  year = {2025},
  month = {September},
  website = {https://eig.org/how-to-end-low-wage-work-forever/},
  abstract = {Roughly 21 million U.S. workers earn less than $16 an hour, concentrated among prime-age men and in specific regions. The 80-80 proposal has the government subsidize 80 percent of the gap between a worker's employer-paid wage and 80 percent of the national median wage, so the subsidy appears directly in every paycheck. Because employers bear none of the cost, the design raises take-home pay without weakening incentives to hire or promote low-wage workers.},
  finding = {The 80-80 proposal would subsidize low-wage paychecks directly, raising take-home pay without adding to employers' cost of hiring.},
  entry_group = {policy_report},
  bibtex_show = {true},
  selected = {true},
}

@techreport{glasner_2025_oz_housing_supply,
  abbr = {EIG},
  title = {The Impact of Opportunity Zones on Housing Supply},
  author = {Glasner, Benjamin and Ozimek, Adam and Lettieri, John},
  institution = {Economic Innovation Group},
