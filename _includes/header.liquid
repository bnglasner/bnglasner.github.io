<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" aria-label="Main">
    <div class="container">
      <a class="navbar-brand title site-wordmark" href="{{ site.baseurl }}/">
        {% include site-mark.liquid %}
        {%- comment -%}
          Wordmark is the name alone; the degree lives on the CV and in
          site.title (page titles, Open Graph), which are unchanged.
        {%- endcomment -%}
        <span class="site-wordmark__name">
          {{- site.first_name }}
          {{ site.last_name -}}
        </span>
      </a>
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign home_title = page.title %} {% endif %}
          {% endfor %}

          <!-- Home -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/' | relative_url }}"
              {% if page.permalink == '/' %}
                aria-current="page"
              {% endif %}
            >
              {{- home_title }}
            </a>
          </li>

          <!--
            Flat nav: Research, Policy writing, Media, Code, CV. No dropdowns
            by design (see design brief) — nav_order on each page's front
            matter controls order.
          -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% assign parent_link = p.permalink | remove: 'index.html' %}
              <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                {%- if p.permalink contains '://' -%}
                  {%- assign url = p.permalink -%}
                {%- else -%}
                  {%- assign url = p.url -%}
                {%- endif %}
                <a
                  class="nav-link"
                  href="{{ url | relative_url }}"
                  {% if page.url contains p.url %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- p.title }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% include axis-rule.liquid class="axis-rule--tight" %}
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
  <script>
    // Theme toggle: name the current setting and the next one, since the
    // button cycles light -> dark -> system (assets/js/theme.js) and its
    // icon alone does not announce state.
    (function () {
      var btn = document.getElementById('light-toggle');
      if (!btn) return;
      var next = { light: 'dark', dark: 'system', system: 'light' };
      function label() {
        var cur = document.documentElement.getAttribute('data-theme-setting') || 'system';
        var text = 'Theme: ' + cur + '. Switch to ' + (next[cur] || 'light');
        btn.setAttribute('aria-label', text);
        btn.setAttribute('title', text);
      }
      label();
      new MutationObserver(label).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme-setting'] });
    })();

    // Mobile nav: Escape closes the expanded menu and returns focus to the
    // toggle (Bootstrap's collapse has no keyboard dismiss of its own).
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var menu = document.getElementById('navbarNav');
      var toggler = document.querySelector('.navbar-toggler');
      if (!menu || !toggler || !menu.classList.contains('show')) return;
      if (window.jQuery) window.jQuery(menu).collapse('hide');
      toggler.focus();
    });
  </script>
</header>
