{% comment %}
  Homepage hero figure: a stylized two-series event-study chart — the
  analytical shape behind most of this research (an outcome that tracks a
  comparison series, then diverges after a policy change). This is an
  illustrative device, not a plot of real results from any specific paper,
  so it carries no numeric axis values that could be mistaken for data.

  The sitewide motion budget is exactly one animation: the treated (teal)
  line draws in via stroke-dashoffset on load. The comparison (amber) line
  and both axes render statically. Disabled entirely under
  prefers-reduced-motion (see _sass/_system.scss).
{% endcomment %}
<svg
  class="hero-figure"
  viewBox="0 0 640 320"
  role="img"
  aria-labelledby="hero-figure-title"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="hero-figure-title">
    Illustrative event-study chart: a treated outcome that tracks a comparison series, then diverges upward after a
    policy change — the analytical pattern behind this research.
  </title>

  <!-- Axes, echoing the axis-rule hairline-with-ticks motif -->
  <line x1="50" y1="260" x2="620" y2="260" stroke="var(--paper-hairline)" stroke-width="1"></line>
  <line x1="50" y1="30" x2="50" y2="260" stroke="var(--paper-hairline)" stroke-width="1"></line>

  <!-- Event marker -->
  <line
    x1="335"
    y1="20"
    x2="335"
    y2="260"
    stroke="var(--paper-muted-soft)"
    stroke-width="1"
    stroke-dasharray="3,4"
  ></line>
  <text x="335" y="278" text-anchor="middle" class="hero-figure__label">POLICY CHANGE</text>

  <text x="50" y="278" text-anchor="start" class="hero-figure__label">t − 6</text>
  <text x="620" y="278" text-anchor="end" class="hero-figure__label">t + 6</text>
  <text x="18" y="30" text-anchor="start" class="hero-figure__label">OUTCOME</text>

  <!-- Comparison series (amber) — static -->
  <path
    d="M50,196 C120,200 180,193 250,197 C290,199 310,198 335,196 C400,198 480,202 560,204 C580,205 600,206 620,207"
    fill="none"
    stroke="var(--accent-amber)"
    stroke-width="2.5"
    stroke-linecap="round"
  ></path>
  <circle cx="620" cy="207" r="4" fill="var(--accent-amber)"></circle>
  <text x="560" y="228" text-anchor="end" class="hero-figure__label hero-figure__label--amber">COMPARISON</text>

  <!-- Treated series (teal) — the one animation on the entire site -->
  <path
    class="hero-figure__line"
    d="M50,192 C120,188 180,196 250,190 C290,187 310,186 335,184 C400,175 480,140 560,105 C580,97 600,92 620,88"
    fill="none"
    stroke="var(--accent-teal)"
    stroke-width="2.5"
    stroke-linecap="round"
    pathLength="1000"
    style="--line-length: 1000"
  ></path>
  <circle cx="620" cy="88" r="4" fill="var(--accent-teal)"></circle>
  <text x="560" y="76" text-anchor="end" class="hero-figure__label hero-figure__label--teal">TREATED</text>
</svg>
