{% if site.enable_google_verification or site.enable_bing_verification %}
  <!-- Website verification -->
  {% if site.enable_google_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if site.enable_bing_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
  <!--
    Avoid warning on Google Chrome Error with Permissions-Policy header:
    Origin trial controlled feature not enabled: 'interest-cohort'.
    see https://stackoverflow.com/a/75119417
  -->
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}

{% comment %}
  Shared values for every tag below. Everything that lands inside a
  content="..." attribute goes through `escape`, and everything that lands
  inside JSON-LD goes through `jsonify`: titles such as The Great
  "Transfer"-mation carry literal double quotes, and site.description is a
  folded YAML scalar that ends in a newline.
{% endcomment %}
{% if site.title == 'blank' %}
  {% assign site_name = author_name %}
{% else %}
  {% assign site_name = site.title %}
{% endif %}
{% if page.entry.title %}
  {% assign page_title = page.entry.title %}
{% elsif page.title != 'blank' and page.url != '/' %}
  {% assign page_title = page.title %}
{% else %}
  {% assign page_title = null %}
{% endif %}

{% if page.description %}
  {% assign meta_desc = page.description %}
{% elsif page.entry.finding %}
  {% assign meta_desc = page.entry.finding %}
{% else %}
  {% assign meta_desc = site.description %}
{% endif %}
{% assign meta_desc = meta_desc | strip_html | strip_newlines | strip %}
{% comment %} Search snippets truncate near 160 characters; cut at a word boundary so the snippet never ends mid-word. {% endcomment %}
{% if meta_desc.size > 160 %}
  {% assign desc_words = meta_desc | slice: 0, 158 | split: ' ' | pop %}
  {% capture meta_desc %}{{ desc_words | join: ' ' | remove_last: ',' | remove_last: ';' }}…{% endcapture %}
{% endif %}

{% if page.og_image %}
  {% assign og_image = page.og_image %}
{% else %}
  {% assign og_image = site.og_image %}
{% endif %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>
  {% if page.seo_title %}
    {{ page.seo_title | escape }}
  {% elsif page.url == '/blog/index.html' %}
    {{ page.title | escape }} | {{ site_name }}
  {% elsif page_title %}
    {{ page_title | escape }} | {{ site_name }}
  {% elsif page.title != 'blank' and page.url != '/' %}
    {{ page.date | date: '%Y' }} | {{ site_name }}
  {% else %}
    {{ site_name }}
  {% endif %}
</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{{ meta_desc | escape }}">
{% if page.url == '/404.html' %}
  <meta name="robots" content="noindex">
{% endif %}

{% if page.entry %}
  {% comment %}
    Google Scholar indexing (Highwire Press tags) on every jekyll-scholar
    permalink page (see _layouts/bibtex.html). The venue tag depends on the
    entry type: a journal title only for @article, the issuing institution
    for @techreport, the degree-granting school for theses. A stray
    `journal` field on a techreport is never emitted as a journal.
  {% endcomment %}
  {% assign entry_type = page.entry.type | default: page.type | downcase %}
  <meta name="citation_title" content="{{ page.entry.title | escape }}">
  {% for author in page.entry.author_array %}
    <meta name="citation_author" content="{{ author.last | escape }}, {{ author.first | escape }}">
  {% endfor %}
  {% if page.entry.month %}
    <meta
      name="citation_publication_date"
      content="{{ page.entry.month | append: ' 1, ' | append: page.entry.year | date: '%Y/%m' }}"
    >
  {% else %}
    <meta name="citation_publication_date" content="{{ page.entry.year }}">
  {% endif %}
  {% case entry_type %}
    {% when 'article' %}
      {% if page.entry.journal %}
        <meta name="citation_journal_title" content="{{ page.entry.journal | escape }}">
      {% endif %}
      {% if page.entry.volume %}
        <meta name="citation_volume" content="{{ page.entry.volume | escape }}">
      {% endif %}
      {% if page.entry.number %}
        <meta name="citation_issue" content="{{ page.entry.number | escape }}">
      {% endif %}
      {% if page.entry.pages %}
        {% assign entry_pages = page.entry.pages | replace: '–', '-' | replace: '—', '-' | split: '-' %}
        <meta name="citation_firstpage" content="{{ entry_pages.first | strip | escape }}">
        {% if entry_pages.size > 1 %}
          <meta name="citation_lastpage" content="{{ entry_pages.last | strip | escape }}">
        {% endif %}
      {% endif %}
    {% when 'techreport' %}
      {% if page.entry.institution %}
        <meta name="citation_technical_report_institution" content="{{ page.entry.institution | escape }}">
      {% endif %}
      {% if page.entry.number %}
        <meta name="citation_technical_report_number" content="{{ page.entry.number | escape }}">
      {% endif %}
    {% when 'phdthesis', 'mastersthesis' %}
      {% if page.entry.school %}
        <meta name="citation_dissertation_institution" content="{{ page.entry.school | escape }}">
      {% endif %}
  {% endcase %}
  {% if page.entry.doi %}
    <meta name="citation_doi" content="{{ page.entry.doi | escape }}">
  {% endif %}
  {% if page.entry.pdf %}
    <meta name="citation_pdf_url" content="{{ page.entry.pdf | absolute_url | escape }}">
  {% endif %}
  <meta name="citation_abstract_html_url" content="{{ page.url | absolute_url }}">
{% endif %}

{% if site.serve_og_meta %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="{{ site_name | escape }}">
  <meta property="og:type" content="{% if page.entry %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if page_title %}{{ page_title | escape }}{% else %}{{ site_name | escape }}{% endif %}">
  <meta property="og:url" content="{{ page.url | replace: 'index.html', '' | absolute_url }}">
  <meta property="og:description" content="{{ meta_desc | escape }}">
  {% if og_image %}
    <meta property="og:image" content="{{ og_image | absolute_url }}">
    {% if og_image == site.og_image %}
      {% if site.og_image_width %}
        <meta property="og:image:width" content="{{ site.og_image_width }}">
        <meta property="og:image:height" content="{{ site.og_image_height }}">
      {% endif %}
      {% if site.og_image_alt %}
        <meta property="og:image:alt" content="{{ site.og_image_alt | escape }}">
      {% endif %}
    {% endif %}
  {% endif %}
  <meta property="og:locale" content="en_US">

  <!-- Twitter card -->
  <meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{% if page_title %}{{ page_title | escape }}{% else %}{{ site_name | escape }}{% endif %}">
  <meta name="twitter:description" content="{{ meta_desc | escape }}">
  {% if og_image %}
    <meta name="twitter:image" content="{{ og_image | absolute_url }}">
    {% if og_image == site.og_image and site.og_image_alt %}
      <meta name="twitter:image:alt" content="{{ site.og_image_alt | escape }}">
    {% endif %}
  {% endif %}
  {% if site.data.socials.x_username %}
    <meta name="twitter:site" content="@{{ site.data.socials.x_username }}">
    <meta name="twitter:creator" content="@{{ site.data.socials.x_username }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  <!-- Schema.org -->
  {% comment %}
    sameAs: every profile in _data/socials.yml that is a real external
    profile of Ben's, plus the institutional bio in site.person.work_url.
    Non-profile keys (cv_pdf, email, rss_icon) are skipped explicitly, and
    nested custom socials contribute only when they carry a url, so the list
    never contains null.
  {% endcomment %}
  {% assign sameaslinks = '' | split: ',' %}
  {% if site.person.work_url %}
    {% assign sameaslinks = sameaslinks | push: site.person.work_url %}
  {% endif %}
  {% for social in site.data.socials %}
    {% assign link = null %}
    {% case social[0] %}
      {% when 'cv_pdf', 'email', 'rss_icon' %}
        {% assign link = null %}
      {% when 'scholar_userid' %}
        {% capture link %}https://scholar.google.com/citations?user={{ social[1] }}{% endcapture %}
      {% when 'orcid_id' %}
        {% capture link %}https://orcid.org/{{ social[1] }}{% endcapture %}
      {% when 'github_username' %}
        {% capture link %}https://github.com/{{ social[1] }}{% endcapture %}
      {% when 'linkedin_username' %}
        {% capture link %}https://www.linkedin.com/in/{{ social[1] }}{% endcapture %}
      {% when 'x_username' %}
        {% capture link %}https://x.com/{{ social[1] }}{% endcapture %}
      {% when 'instagram_id' %}
        {% capture link %}https://www.instagram.com/{{ social[1] }}{% endcapture %}
      {% when 'bluesky_url' %}
        {% assign link = social[1] %}
      {% else %}
        {% if social[1].url %}
          {% assign link = social[1].url %}
        {% endif %}
    {% endcase %}
    {% if link and link != '' %}
      {% assign sameaslinks = sameaslinks | push: link %}
    {% endif %}
  {% endfor %}
  {% capture person_id %}{{ '/' | absolute_url }}#person{% endcapture %}

  {% if page.entry %}
    {% comment %} Per-paper permalink page: the work itself, not the website. {% endcomment %}
    {% assign entry_type = page.entry.type | default: page.type | downcase %}
    {% case entry_type %}
      {% when 'techreport' %}
        {% assign schema_type = 'Report' %}
      {% when 'phdthesis', 'mastersthesis' %}
        {% assign schema_type = 'Thesis' %}
      {% else %}
        {% assign schema_type = 'ScholarlyArticle' %}
    {% endcase %}
    {% assign entry_abstract = page.entry.abstract | default: page.entry.finding | strip_html | strip_newlines | strip %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": {{ schema_type | jsonify }},
        "@id": {{ page.url | absolute_url | append: '#work' | jsonify }},
        "url": {{ page.url | absolute_url | jsonify }},
        "headline": {{ page.entry.title | truncate: 110 | jsonify }},
        "name": {{ page.entry.title | jsonify }},
        {% if entry_abstract != '' %}"abstract": {{ entry_abstract | jsonify }},{% endif %}
        "datePublished": {{ page.entry.year | append: '' | jsonify }},
        "author": [
          {% for author in page.entry.author_array %}
            {% capture full_name %}{{ author.first }} {{ author.last }}{% endcapture %}
            {% if author.last == site.last_name %}
              {"@type": "Person", "@id": {{ person_id | jsonify }}, "name": {{ full_name | strip | jsonify }}}
            {% else %}
              {"@type": "Person", "name": {{ full_name | strip | jsonify }}}
            {% endif %}{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ],
        {% if entry_type == 'article' and page.entry.journal %}
        "isPartOf": {"@type": "Periodical", "name": {{ page.entry.journal | jsonify }}},
        {% if page.entry.volume %}"volumeNumber": {{ page.entry.volume | append: '' | jsonify }},{% endif %}
        {% if page.entry.number %}"issueNumber": {{ page.entry.number | append: '' | jsonify }},{% endif %}
        {% if page.entry.pages %}"pagination": {{ page.entry.pages | append: '' | jsonify }},{% endif %}
        {% elsif page.entry.institution %}
        "publisher": {"@type": "Organization", "name": {{ page.entry.institution | jsonify }}},
        {% elsif page.entry.school %}
        "sourceOrganization": {"@type": "Organization", "name": {{ page.entry.school | jsonify }}},
        {% endif %}
        {% if page.entry.doi %}"identifier": {{ 'https://doi.org/' | append: page.entry.doi | jsonify }},{% endif %}
        {% if page.entry.website %}"sameAs": {{ page.entry.website | jsonify }},{% endif %}
        {% if og_image %}"image": {{ og_image | absolute_url | jsonify }},{% endif %}
        "mainEntityOfPage": {{ page.url | absolute_url | jsonify }}
      }
    </script>
  {% else %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": {{ person_id | jsonify }},
            "name": {{ author_name | strip | jsonify }},
            {% if site.person.alternate_name %}"alternateName": {{ site.person.alternate_name | jsonify }},{% endif %}
            {% if site.person.job_title %}"jobTitle": {{ site.person.job_title | jsonify }},{% endif %}
            {% if site.person.works_for %}
            "worksFor": {"@type": "Organization", "name": {{ site.person.works_for.name | jsonify }}, "url": {{ site.person.works_for.url | jsonify }}},
            {% endif %}
            {% if site.person.affiliation %}
            "affiliation": {
              "@type": "Organization",
              "name": {{ site.person.affiliation.name | jsonify }},
              "parentOrganization": {"@type": "CollegeOrUniversity", "name": {{ site.person.affiliation.parent | jsonify }}}
            },
            {% endif %}
            {% if site.person.alumni_of %}
            "alumniOf": [
              {% for school in site.person.alumni_of %}{"@type": "CollegeOrUniversity", "name": {{ school | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}
            ],
            {% endif %}
            {% if site.person.knows_about %}"knowsAbout": {{ site.person.knows_about | jsonify }},{% endif %}
            {% if site.person.image %}"image": {{ site.person.image | absolute_url | jsonify }},{% endif %}
            {% if site.person.address_locality %}
            "workLocation": {"@type": "Place", "name": {{ site.person.address_locality | jsonify }}},
            {% endif %}
            "url": {{ '/' | absolute_url | jsonify }},
            "sameAs": {{ sameaslinks | jsonify }}
          },
          {
            "@type": "WebSite",
            "@id": {{ '/' | absolute_url | append: '#website' | jsonify }},
            "url": {{ '/' | absolute_url | jsonify }},
            "name": {{ site_name | jsonify }},
            "description": {{ site.description | strip_newlines | strip | jsonify }},
            "inLanguage": {{ site.lang | jsonify }},
            "author": {"@id": {{ person_id | jsonify }}}
          },
          {
            "@type": {% if page.url == '/' %}"ProfilePage"{% else %}"WebPage"{% endif %},
            "@id": {{ page.url | replace: 'index.html', '' | absolute_url | jsonify }},
            "url": {{ page.url | replace: 'index.html', '' | absolute_url | jsonify }},
            "name": {% if page_title %}{{ page_title | jsonify }}{% else %}{{ site_name | jsonify }}{% endif %},
            "description": {{ meta_desc | jsonify }},
            "isPartOf": {"@id": {{ '/' | absolute_url | append: '#website' | jsonify }}},
            {% if page.url == '/' %}"mainEntity": {"@id": {{ person_id | jsonify }}},{% endif %}
            "about": {"@id": {{ person_id | jsonify }}}
          }
        ]
      }
    </script>
  {% endif %}
{% endif %}
