{% assign tiktok_profile_url = site.data.socials.tiktok_url.url %}
{% assign tiktok_username = tiktok_profile_url | split: '@' | last | split: '?' | first | split: '/' | first %}

<div class="tiktok-feature">
  <blockquote
    class="tiktok-embed"
    cite="{{ tiktok_profile_url }}"
    data-unique-id="{{ tiktok_username }}"
    data-embed-type="creator"
    data-embed-from="oembed"
    style="max-width: 720px; min-width: 288px;"
  >
    <section>
      <a target="_blank" href="{{ tiktok_profile_url }}?refer=creator_embed" rel="noopener noreferrer">
        @{{ tiktok_username }}
      </a>
    </section>
  </blockquote>
</div>
