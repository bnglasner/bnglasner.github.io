---
layout: default
---
<div class="post">
  <div class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
          aria-label="Download CV PDF"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </div>

  <article>
    {{ content }}

    {% if site.data.cv_assets and site.data.cv_assets.variants %}
      <div class="cv__pdf-variants">
        {% for variant in site.data.cv_assets.variants %}
          <a class="btn-cta btn-cta--secondary" href="{{ variant.pdf | relative_url }}" target="_blank" rel="noopener noreferrer">
            {{ variant.label }}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% assign sections = site.data.cv %}
    {% if sections and sections.size > 0 %}
      <div class="cv">
        {% for section in sections %}
          <a class="anchor" id="{{ section.title | slugify }}"></a>
          <div class="card mt-3 p-3">
            <h2 class="card-title font-weight-medium h3">{{ section.title }}</h2>

            {% if section.type == 'map' %}
              <table class="table table-cv table-sm table-borderless mb-0">
                {% for row in section.contents %}
                  <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                      <b>{{ row.name }}</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light">{{ row.value }}</td>
                  </tr>
                {% endfor %}
              </table>

            {% elsif section.type == 'time_table' %}
              {% for entry in section.contents %}
                <div class="{% unless forloop.last %}mb-4{% endunless %}">
                  <div class="d-flex flex-wrap justify-content-between align-items-start">
                    <div>
                      {% if entry.title %}
                        <h3 class="h5 mb-1">{{ entry.title }}</h3>
                      {% endif %}
                      {% if entry.institution or entry.location %}
                        <p class="mb-1 text-muted">
                          {% if entry.url %}
                            <a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">
                              {{ entry.institution | default: entry.url }}
                            </a>
                          {% elsif entry.institution_url %}
                            <a href="{{ entry.institution_url }}" target="_blank" rel="noopener noreferrer">{{ entry.institution }}</a>
                          {% else %}
                            {{ entry.institution }}
                          {% endif %}
                          {% if entry.institution and entry.location %}
                            <span>&middot;</span>
                          {% endif %}
                          {% if entry.location %}
                            {{ entry.location }}
                          {% endif %}
                        </p>
                      {% endif %}
                    </div>
                    {% if entry.year %}
                      <p class="mb-1 text-muted">{{ entry.year }}</p>
                    {% endif %}
                  </div>

                  {% if entry.description %}
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {% for item in entry.description %}
                        <li class="list-group-item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
                      {% endfor %}
                    </ul>
                  {% endif %}

                  {% if entry.items %}
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {% for item in entry.items %}
                        <li class="list-group-item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
                      {% endfor %}
                    </ul>
                  {% endif %}

                  {% if entry.linkitems %}
                    <p class="mt-2 mb-0 font-weight-light">
                      {% for link in entry.linkitems %}
                        <a href="{{ link.link }}" target="_blank" rel="noopener noreferrer">{{ link.linkname }}</a>
                        {%- unless forloop.last %} &middot; {% endunless %}
                      {% endfor %}
                    </p>
                  {% endif %}
                </div>
              {% endfor %}

            {% elsif section.type == 'nested_list' %}
              {% for group in section.contents %}
                <div class="{% unless forloop.last %}mb-3{% endunless %}">
                  {% if group.title %}
                    <h3 class="h5 mb-2">{{ group.title }}</h3>
                  {% endif %}
                  {% if group.items %}
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {% for item in group.items %}
                        <li class="list-group-item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>
              {% endfor %}

            {% elsif section.type == 'list' %}
              <ul class="card-text font-weight-light list-group list-group-flush">
                {% for item in section.contents %}
                  <li class="list-group-item">
                    {% if item.name and item.value %}
                      <strong>{{ item.name }}:</strong> {{ item.value }}
                    {% else %}
                      {{ item | markdownify | remove: '<p>' | remove: '</p>' }}
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>

            {% else %}
              {% for item in section.contents %}
                <div class="{% unless forloop.last %}mb-3{% endunless %}">
                  {% if item.title %}
                    <h3 class="h5 mb-1">{{ item.title }}</h3>
                  {% endif %}
                  {% if item.value %}
                    <p class="mb-0">{{ item.value }}</p>
                  {% elsif item %}
                    <p class="mb-0">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</p>
                  {% endif %}
                </div>
              {% endfor %}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p>No CV data found in <code>_data/cv.yml</code>.</p>
    {% endif %}
  </article>
</div>
